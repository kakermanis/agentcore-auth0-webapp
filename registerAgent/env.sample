# Copy to .env in this folder and populate it. Values below are prescriptive
# defaults for the SE Summit lab -- use them as-is unless you have a specific
# reason not to, and make sure they match the root .env's values where noted.

# agentcore_deployment.py only ever runs locally (never inside the deployed container),
# so it authenticates via an AWS SSO profile rather than a hand-copied credential triple.
# Run `aws configure sso` first, then set the profile name it gives you here. This
# must be the SAME profile as AWS_PROFILE in the root .env -- deployAgentCore checks
# this profile's SSO session before deploying and refreshes it if expired.
AWS_PROFILE=your-sso-profile-name

# Must match AWS_REGION in the root .env -- same region, both files (the var name
# differs because this one feeds the local deploy script's own boto3 session, while
# the root app reads its own AWS_REGION directly -- the *value* must still match).
AWS_DEFAULT_REGION=us-west-2

# Auth0 configuration required by agentcore_deployment.py. Also used directly by
# agentcore_agent.py for CIBA -- CIBA reuses this same application (Token Vault + CIBA
# grant types ticked on it), not a separate app/tenant. Same values as the root .env.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
# Must be the identical string as AUTH0_AUDIENCE in the root .env.
AUTH0_AUDIENCE=https://agentcore-lab-api

# DynamoDB session table -- must match SESSION_TABLE_NAME in the root .env.
SESSION_TABLE_NAME=agentcore-lab-sessions

# CIBA request defaults -- used only if invokeCiba isn't called with its own scope/
# binding_message arguments. binding_message is shown to the user on their CIBA push
# approval device.
CIBA_SCOPE=openid profile
CIBA_BINDING_MESSAGE=RESET PASSWORD FLOW

# Auth0 FGA store/client credentials -- these seven names match what the FGA store's own
# config output gives you, so it can be pasted in directly (SETUP.md Section 5.4).
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=your-fga-store-id
FGA_MODEL_ID=your-fga-model-id
FGA_API_TOKEN_ISSUER=your-fga-token-issuer
FGA_API_AUDIENCE=your-fga-audience
FGA_CLIENT_ID=your-fga-client-id
FGA_CLIENT_SECRET=your-fga-client-secret

# Not part of FGA's output -- always "https" in practice, kept as its own var because the
# OpenFGA SDK's ClientConfiguration wants scheme and host passed separately.
FGA_API_SCHEME=https

# AgentCore Gateway MCP endpoint (SETUP.md Section 5.x, Gateway setup) -- account/
# Gateway-specific, can't be prescriptive here. Format:
# https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
MCP_GATEWAY_URL=https://your-gateway-id.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp

# Bare Okta org domain -- NOT the -admin console hostname. See SETUP.md Section 4.
OKTA_DOMAIN=your-okta-domain.okta.com

# Bedrock model ID for the agent. This default is a global cross-region inference
# profile ID that should be broadly available, but model availability/deprecation
# changes over time -- verify it's still live in the Bedrock console's model catalog
# (or `aws bedrock list-inference-profiles --region <region>`) before deploying; see
# SETUP.md Section 4. Leaving this blank still counts as "set" (an empty string), so
# it will NOT fall through to any code-level default -- it must be a real value.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5

#!/usr/bin/env bash
# Deploys the CloudFormation stacks under infrastructure/templates/ that automate
# README.md Section 5.5.2 (DynamoDB table), 5.8 (execution role + DynamoDB policy), and
# 5.10 (mock Lambda + Gateway + GatewayTarget). Plain AWS CLI, no CDK.
#
# Run this at README Section 5.5.2 - before agentCoreDeployment/.env exists (it isn't
# populated until 5.6), so this prompts for the handful of values needed at this point
# in the walkthrough rather than reading them from a file that doesn't exist yet.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATES_DIR="$SCRIPT_DIR/infrastructure/templates"

prompt_if_unset() {
    local var_name="$1"
    local prompt_text="$2"
    local current_value="${!var_name:-}"
    if [ -z "$current_value" ]; then
        read -r -p "$prompt_text: " current_value
        if [ -z "$current_value" ]; then
            echo "$var_name is required." >&2
            exit 1
        fi
        printf -v "$var_name" '%s' "$current_value"
    fi
}

# If you've already exported these (e.g. scripting a repeat deploy), the prompts below
# are skipped and your exported values are used instead.
prompt_if_unset AWS_PROFILE "AWS SSO profile name (from 'aws configure sso', Section 5.5.1)"
prompt_if_unset AUTH0_DOMAIN "Auth0 tenant domain, e.g. your-tenant.auth0.com (Section 5.3.1)"
prompt_if_unset AUTH0_CLIENT_ID "Auth0 application Client ID (Section 5.3.1)"

echo ""
echo "Checking AWS SSO session for profile '$AWS_PROFILE'..."
if ! aws sts get-caller-identity --profile "$AWS_PROFILE" >/dev/null 2>&1; then
    echo "SSO session for '$AWS_PROFILE' is missing or expired - running 'aws sso login'..."
    aws sso login --profile "$AWS_PROFILE"
fi

# Resolve region the same way agentcore_deployment.py does - from AWS_DEFAULT_REGION if
# set, otherwise whatever region the SSO profile itself is configured for. Deliberately
# no hardcoded fallback (e.g. us-west-2) - this should always follow the user's own
# .env/profile configuration, not an assumption baked into this script.
REGION="${AWS_DEFAULT_REGION:-$(aws configure get region --profile "$AWS_PROFILE" || true)}"
if [ -z "$REGION" ]; then
    echo "Could not resolve a region - export AWS_DEFAULT_REGION, or set a default region" >&2
    echo "on the '$AWS_PROFILE' SSO profile (matching agentCoreDeployment/.env)." >&2
    exit 1
fi
echo "Using region: $REGION"

deploy_stack() {
    local stack_name="$1"
    local template_file="$2"
    shift 2
    echo ""
    echo "--- Deploying $stack_name ---"
    aws cloudformation deploy \
        --profile "$AWS_PROFILE" \
        --region "$REGION" \
        --stack-name "$stack_name" \
        --template-file "$template_file" \
        --capabilities CAPABILITY_NAMED_IAM \
        "$@"
}

stack_output() {
    local stack_name="$1"
    local output_key="$2"
    aws cloudformation describe-stacks \
        --profile "$AWS_PROFILE" \
        --region "$REGION" \
        --stack-name "$stack_name" \
        --query "Stacks[0].Outputs[?OutputKey=='$output_key'].OutputValue" \
        --output text
}

deploy_stack sesummit-agentcore-session-table "$TEMPLATES_DIR/01-session-table.yaml"

deploy_stack sesummit-agentcore-execution-role "$TEMPLATES_DIR/02-agent-execution-role.yaml"

deploy_stack sesummit-agentcore-gateway "$TEMPLATES_DIR/03-gateway.yaml" \
    --parameter-overrides "AuthDomain=$AUTH0_DOMAIN" "AuthClientId=$AUTH0_CLIENT_ID"

echo ""
echo "=== Done. Copy these into your .env files (they are NOT written automatically): ==="
echo ""
echo "agentCoreDeployment/.env and chatWebApp/.env:"
echo "  SESSION_TABLE_NAME=$(stack_output sesummit-agentcore-session-table TableName)"
echo ""
echo "agentCoreDeployment/.env:"
echo "  AGENT_EXECUTION_ROLE_ARN=$(stack_output sesummit-agentcore-execution-role ExecutionRoleArn)"
echo "  MCP_GATEWAY_URL=$(stack_output sesummit-agentcore-gateway GatewayUrl)"
echo ""
echo "After updating agentCoreDeployment/.env, re-run ./deployAgentCore to pick up the"
echo "new execution role, table name, and Gateway URL."

# Copy to .env in this folder and populate it. Values below are prescriptive
# defaults for the SE Summit lab, not arbitrary examples — use them as-is unless
# you have a specific reason not to. That keeps the values in this file, the
# values in registerAgent/env.sample, and what you type into Auth0/Okta/AWS
# consoles all consistent with each other, which is most of what avoids the
# "everything is subtly misconfigured in a different way on every machine" problem.

# Flask/Starlette session signing key — generate your own, don't reuse this one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=your-generated-secret-key-here

# --- Auth0 (tenant-specific — from your own Auth0 application) ---
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_DOMAIN=your-tenant.auth0.com

# Custom API you create yourself (Auth0 Dashboard -> Applications -> APIs -> Create API).
# This is NOT the built-in MyAccount API — see SETUP.md Section 5.3.1. The identifier
# is an arbitrary string, not a real URL; use this exact value so it's trivial to
# cross-check against registerAgent/.env, which must have the identical string.
AUTH0_AUDIENCE=https://agentcore-lab-api

# Scopes requested at login. create:me:connected_accounts is required for the
# "Connect Account" button to work (Auth0's MyAccount API rejects the connect
# request without it) — don't drop it if you customize this.
AUTH0_SCOPE=openid profile email offline_access okta.users.read read:me:connected_accounts create:me:connected_accounts

# Scopes requested on the external (Okta) connection during "Connect Account".
# okta.users.read must ALSO be set on the connection's own default scope in the
# Auth0 Dashboard (SETUP.md Section 5.3.2) -- setting it only here is not enough.
CONNECTED_ACCOUNT_SCOPE=openid profile email offline_access okta.users.read

# The enterprise (Okta OIDC) connection's own "Name" field in Auth0 -- name it
# exactly this when you create it (SETUP.md Section 5.3.2) so this value is
# correct without editing.
AUTH0_CONNECTION_NAME=okta-agentcore

# --- AWS ---
# This is Okta-issued SSO-backed AWS access (see SETUP.md Section 3 and 5.5) --
# there are no long-lived access keys anywhere in this lab. Run `aws configure sso`
# once, then set the resulting profile name here. runLocalApp checks this profile's
# SSO session before starting the app and refreshes it (`aws sso login`) if it's
# expired -- you don't need to do that by hand.
AWS_PROFILE=your-sso-profile-name

# Must match AWS_DEFAULT_REGION in registerAgent/.env -- same region, both files.
AWS_REGION=us-west-2

# DynamoDB session table -- must match SESSION_TABLE_NAME in registerAgent/.env.
# You create this table yourself (SETUP.md Section 5.5) -- it is not auto-created.
SESSION_TABLE_NAME=agentcore-lab-sessions

# Filled in after you run ./deployAgentCore (SETUP.md Section 5.8) -- it prints
# this ARN at the end.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<your-aws-region>:<your-account-id>:runtime/<your-runtime-id>

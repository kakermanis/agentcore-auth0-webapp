#!/usr/bin/env bash
# Deploys the agent under agentCoreDeployment/ to AWS Bedrock AgentCore Runtime.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/agentCoreDeployment"

if [ ! -f .env ]; then
    echo "agentCoreDeployment/.env not found — copy env.sample to .env and populate it first." >&2
    exit 1
fi

# Ensure the AWS SSO session backing AWS_PROFILE is live before spending time on a
# CodeBuild deploy that would otherwise fail partway through with a stale-token error.
AWS_PROFILE_VALUE="$(sed -n 's/^AWS_PROFILE=//p' .env | tail -n1)"
if [ -z "$AWS_PROFILE_VALUE" ]; then
    echo "AWS_PROFILE not set in agentCoreDeployment/.env — set it first (see env.sample)." >&2
    exit 1
fi
if ! command -v aws >/dev/null 2>&1; then
    echo "AWS CLI not found — install it first (see README.md Section 3)." >&2
    exit 1
fi
export AWS_PROFILE="$AWS_PROFILE_VALUE"
echo "Checking AWS SSO session for profile '$AWS_PROFILE'..."
if ! aws sts get-caller-identity --profile "$AWS_PROFILE" >/dev/null 2>&1; then
    echo "SSO session for '$AWS_PROFILE' is missing or expired — running 'aws sso login'..."
    aws sso login --profile "$AWS_PROFILE"
fi

# Prefer a real Python 3.10+ (Homebrew) over macOS's ancient Command Line Tools python3.
BASE_PYTHON="$(command -v python3.12 || command -v /opt/homebrew/opt/python@3.12/bin/python3.12 || command -v python3.11 || command -v python3.10 || command -v python3)"

if [ ! -d .venv ]; then
    "$BASE_PYTHON" -m venv .venv
fi
source .venv/bin/activate

pip install -r requirements.txt
python agentcore_deployment.py
